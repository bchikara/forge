# Forge — copy to .env and fill in. .env is gitignored; never commit it.

# ---------------------------------------------------------------
# Gmail sending
# ---------------------------------------------------------------
# App Password, NOT your account password.
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the account first.
# It is 16 characters, shown with spaces — paste it WITHOUT spaces.
GMAIL_USER=you@gmail.com
# Paste the 16 characters here with no spaces. Left empty on purpose:
# a realistic-looking placeholder trips secret scanners.
GMAIL_APP_PASSWORD=

FORGE_FROM_NAME=Bhupesh Chikara
FORGE_REPLY_TO=

# Transport: gmail | smtp
# Switch to smtp once builtbychikara.dev has SPF/DKIM/DMARC set up.
# Gmail throttles cold volume well below its published 500/day.
FORGE_MAIL_TRANSPORT=gmail

# SMTP (for the custom-domain migration later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------
# jobright.ai contact resolution
# ---------------------------------------------------------------
# If you have a documented API key, set JOBRIGHT_API_KEY.
# If you are replaying a curl from the web app, set the session cookie
# instead — expect it to expire and need refreshing.
JOBRIGHT_BASE_URL=
JOBRIGHT_API_KEY=
JOBRIGHT_SESSION_COOKIE=
JOBRIGHT_TIMEOUT_MS=15000

# ---------------------------------------------------------------
# Safety — leave dry run ON until a full rehearsal looks right
# ---------------------------------------------------------------
FORGE_DRY_RUN=true

# CAN-SPAM requires a real postal address on commercial mail.
FORGE_POSTAL_ADDRESS=

# ---------------------------------------------------------------
# Volume caps
# ---------------------------------------------------------------
FORGE_MAX_COMPANIES_PER_RUN=50
FORGE_MAX_CONTACTS_PER_COMPANY=10
FORGE_CAP_HM=4
FORGE_CAP_RECRUITER=3
FORGE_CAP_LEADER=3
FORGE_MIN_EMAIL_CONFIDENCE=0.7

# ---------------------------------------------------------------
# Pacing and jitter
# ---------------------------------------------------------------
FORGE_DAILY_SEND_CAP=300
FORGE_BASE_DELAY_MS=2000
FORGE_LONG_PAUSE_EVERY=25
FORGE_LONG_PAUSE_MS=120000

# Warmup ramp for a cold sending identity
FORGE_WARMUP_ENABLED=true
FORGE_WARMUP_START_CAP=15
FORGE_WARMUP_INCREMENT=10

# Send window (local hours, 24h)
FORGE_SEND_START_HOUR=8
FORGE_SEND_END_HOUR=18
FORGE_SKIP_WEEKENDS=true

# Abort the run if bounces spike
FORGE_MAX_BOUNCE_RATE=0.08
FORGE_MIN_SENDS_BEFORE_CHECK=20

# ---------------------------------------------------------------
# Sequencing
# ---------------------------------------------------------------
FORGE_MAX_SEQUENCE_STEPS=2
FORGE_FOLLOWUP_DAYS=7

# ---------------------------------------------------------------
# Unipile — LinkedIn search and connection invitations
# ---------------------------------------------------------------
UNIPILE_BASE_URL=https://apiXX.unipile.com:PORT
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# Invitation quotas. weeklyCap is the operator's measured figure for
# this account; lower it if acceptance rate falls.
FORGE_INVITE_WEEKLY_CAP=280
FORGE_INVITE_DAILY_CAP=45
FORGE_INVITE_BASE_DELAY_MS=90000
FORGE_INVITE_JITTER_MIN_MS=30000
FORGE_INVITE_JITTER_MAX_MS=240000
FORGE_MIN_ACCEPTANCE_RATE=0.3
FORGE_MIN_INVITES_BEFORE_CHECK=40
FORGE_INVITE_MAX_PER_COMPANY=10

# Pacing model taken from job-outreach-cli (proven in production)
FORGE_PER_HOUR_CAP=100
FORGE_JITTER_MIN_PCT=0.1
FORGE_JITTER_MAX_PCT=0.3
FORGE_MAX_PER_CONNECTION=20

# ---------------------------------------------------------------
# Daily report
# ---------------------------------------------------------------
# Defaults to the sending address if left empty.
FORGE_REPORT_TO=
FORGE_REPORT_ENABLED=true

# ---------------------------------------------------------------
# Job search filter (passed to tsenta get-job-recommendations)
# ---------------------------------------------------------------
# Structured tokens only: country:US / state:CA / city:Austin
FORGE_SEARCH_LOCATIONS=country:US
FORGE_SEARCH_JOB_TYPES=EXPERIENCED,MID_LEVEL
FORGE_SEARCH_ROLE_FAMILIES=SOFTWARE_ENGINEERING
# 6h | 24h | 1d | 7d | 14d | 30d | all
FORGE_SEARCH_DATE_POSTED=7d
FORGE_SEARCH_LIMIT=50
FORGE_MIN_MATCH_SCORE=60
# Applications wanted per day across all runs; the afternoon run tops up.
FORGE_DAILY_APPLICATION_TARGET=50
